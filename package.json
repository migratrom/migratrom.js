{
	"name": "migratrom",
	"version": "0.0.4",
	"description": "PostgreSQL and SQLite schema migrations for Bun, Node, and Deno",
	"keywords": [
		"bun",
		"ddl",
		"migrations",
		"postgresql",
		"schema",
		"sqlite"
	],
	"homepage": "https://github.com/mofax/migratrom#readme",
	"bugs": {
		"url": "https://github.com/mofax/migratrom/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mofax/migratrom.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./adapters/postgres": {
			"types": "./dist/adapters/postgres.d.ts",
			"import": "./dist/adapters/postgres.js"
		},
		"./adapters/sqlite": {
			"types": "./dist/adapters/sqlite.d.ts",
			"import": "./dist/adapters/sqlite.js"
		}
	},
	"scripts": {
		"build": "vp pack",
		"prepack": "vp pack",
		"prepublishOnly": "vp pack",
		"test:unit": "bun test src_tests/",
		"test:integration": "bun src_tests_integration/harness.ts",
		"test:sqlite-smoke": "bun scripts/sqlite-smoke.mjs",
		"fmt": "vp fmt -c .oxfmtrc.json",
		"lint": "vp lint"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"libsql": "^0.5.29",
		"postgres": "^3.4.5",
		"typescript": "^6.0.3",
		"vite-plus": "latest"
	},
	"peerDependencies": {
		"libsql": "^0.5.29",
		"postgres": "^3.4.0"
	},
	"peerDependenciesMeta": {
		"libsql": {
			"optional": true
		},
		"postgres": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18"
	}
}
